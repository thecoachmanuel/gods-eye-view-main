{"id":1,"type":"Feature","geometry":{"type":"Point","coordinates":[6.6667,11.6667]},"properties":{"name":"Zamfara Forest Banditry Zone","type":"banditry","status":"active","region":"Northwest","state":"Zamfara","severity":"critical","description":"Major banditry and kidnapping hotspot. Armed gangs operate from dense forest cover. Thousands displaced since 2019.","tags":{"name":"Zamfara Forest","type":"security_zone","threat":"banditry","status":"active"}}}
{"id":2,"type":"Feature","geometry":{"type":"Point","coordinates":[13.8000,11.8500]},"properties":{"name":"Sambisa Forest","type":"insurgency","status":"active","region":"Northeast","state":"Borno","severity":"critical","description":"Known ISWAP and Boko Haram operational base. Significant military operations ongoing. Base used for training and logistics.","tags":{"name":"Sambisa Forest","type":"security_zone","threat":"insurgency","status":"active"}}}
{"id":3,"type":"Feature","geometry":{"type":"Point","coordinates":[6.4667,12.3167]},"properties":{"name":"Gusau Kidnapping Corridor","type":"kidnapping","status":"active","region":"Northwest","state":"Zamfara","severity":"high","description":"Active kidnapping route used by armed gangs. Multiple mass abductions recorded including school children.","tags":{"name":"Gusau Corridor","type":"security_zone","threat":"kidnapping","status":"active"}}}
{"id":4,"type":"Feature","geometry":{"type":"Point","coordinates":[8.3600,12.9900]},"properties":{"name":"Kankara Abduction Site","type":"mass_abduction","status":"resolved","region":"Northwest","state":"Katsina","severity":"high","description":"Site of December 2020 mass abduction of 344 schoolboys. Area remains insecure with periodic kidnapping incidents.","tags":{"name":"Kankara","type":"security_zone","threat":"kidnapping","date":"2020-12"}}}
{"id":5,"type":"Feature","geometry":{"type":"Point","coordinates":[7.7500,8.8500]},"properties":{"name":"Benue Farmer-Herder Conflict Zone","type":"farmer_herder_conflict","status":"active","region":"North Central","state":"Benue","severity":"high","description":"Ongoing violent clashes between Fulani herders and local farming communities. High civilian casualties. Mass displacement to Makurdi IDP camps.","tags":{"name":"Benue Valley","type":"security_zone","threat":"farmer_herder","status":"active"}}}
{"id":6,"type":"Feature","geometry":{"type":"Point","coordinates":[8.8958,9.9170]},"properties":{"name":"Plateau State Attacks","type":"communal_violence","status":"active","region":"North Central","state":"Plateau","severity":"high","description":"Recurring communal and herder-farmer attacks around Jos and Barkin Ladi. Thousands killed since 2010. Ongoing displacement.","tags":{"name":"Plateau State","type":"security_zone","threat":"communal_violence","status":"active"}}}
{"id":7,"type":"Feature","geometry":{"type":"Point","coordinates":[5.7667,5.5167]},"properties":{"name":"Niger Delta Militant Zone","type":"oil_militancy","status":"intermittent","region":"South South","state":"Delta","severity":"medium","description":"Pipeline vandalism, oil bunkering, and sporadic militant activity. MEND and splinter groups active in creek areas. Major pipeline infrastructure at risk.","tags":{"name":"Niger Delta","type":"security_zone","threat":"oil_militancy","status":"intermittent"}}}
{"id":8,"type":"Feature","geometry":{"type":"Point","coordinates":[13.6000,11.5000]},"properties":{"name":"Gwoza Hills Insurgency Zone","type":"insurgency","status":"active","region":"Northeast","state":"Borno","severity":"critical","description":"Boko Haram historically controlled territory bordering Cameroon. Ongoing ISWAP presence. Frequent military operations.","tags":{"name":"Gwoza Hills","type":"security_zone","threat":"insurgency","status":"active"}}}
{"id":9,"type":"Feature","geometry":{"type":"Point","coordinates":[13.2667,11.0333]},"properties":{"name":"Bama IDP Displacement Zone","type":"displacement","status":"active","region":"Northeast","state":"Borno","severity":"high","description":"Major IDP concentration area. Town devastated by Boko Haram in 2014, partially recovered. Ongoing humanitarian crisis with 2M+ displaced in the Lake Chad basin.","tags":{"name":"Bama","type":"idp_zone","status":"active"}}}
{"id":10,"type":"Feature","geometry":{"type":"Point","coordinates":[7.3400,11.3900]},"properties":{"name":"Birnin Gwari Banditry Route","type":"banditry","status":"active","region":"Northwest","state":"Kaduna","severity":"high","description":"Key banditry corridor linking Kaduna to Zamfara. Frequent highway ambushes and mass abductions on the Kaduna-Birnin Gwari Road.","tags":{"name":"Birnin Gwari","type":"security_zone","threat":"banditry","status":"active"}}}
{"id":11,"type":"Feature","geometry":{"type":"Point","coordinates":[5.0000,5.5167]},"properties":{"name":"Warri Creek Piracy Zone","type":"maritime_piracy","status":"intermittent","region":"South South","state":"Delta","severity":"medium","description":"Gulf of Guinea piracy hotspot. Armed robbery at sea, crew kidnapping, and illegal bunkering operations in the creek waterways.","tags":{"name":"Warri Creeks","type":"security_zone","threat":"maritime_piracy","status":"intermittent"}}}
{"id":12,"type":"Feature","geometry":{"type":"Point","coordinates":[13.2833,13.8167]},"properties":{"name":"Lake Chad ISWAP Zone","type":"insurgency","status":"active","region":"Northeast","state":"Borno","severity":"critical","description":"ISWAP stronghold on Lake Chad islands. Controls supply routes and tax farmers. Nigerian military conducting multinational force operations with Chad, Niger, Cameroon.","tags":{"name":"Lake Chad Islands","type":"security_zone","threat":"iswap","status":"active"}}}
{"id":13,"type":"Feature","geometry":{"type":"Point","coordinates":[11.5000,12.8000]},"properties":{"name":"Yobe Open Grazing Conflict","type":"farmer_herder_conflict","status":"active","region":"Northeast","state":"Yobe","severity":"medium","description":"Fulani herder-farmer clashes over grazing land and water resources. Exacerbated by drought and desertification spreading from the Sahel.","tags":{"name":"Yobe Grazing Conflict","type":"security_zone","threat":"farmer_herder","status":"active"}}}
{"id":14,"type":"Feature","geometry":{"type":"Point","coordinates":[5.6200,4.9700]},"properties":{"name":"Brass Terminal Security Zone","type":"oil_militancy","status":"intermittent","region":"South South","state":"Bayelsa","severity":"medium","description":"Brass oil terminal and surrounding waterways subject to illegal oil bunkering. Armed groups intercept crude in transit. HYPREP environmental remediation ongoing.","tags":{"name":"Brass Terminal","type":"security_zone","threat":"oil_theft","status":"intermittent"}}}
{"id":15,"type":"Feature","geometry":{"type":"Point","coordinates":[7.2667,8.1167]},"properties":{"name":"Abuja-Kaduna Road Banditry","type":"banditry","status":"active","region":"North Central","state":"Kaduna","severity":"high","description":"One of Nigeria's most dangerous highways. Mass abductions and armed robbery commonplace. Train attack March 2022 killed 8, abducted 168. NRC passenger service suspended multiple times.","tags":{"name":"Abuja-Kaduna Highway","type":"security_zone","threat":"banditry","status":"active"}}}
